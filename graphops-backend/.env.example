# ---------- App ----------
APP_NAME=GraphOps Brain API
ENV=development
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Used later for signing login cookies/JWT. Change it.
JWT_SECRET=change-me-before-deploying

# ---------- FalkorDB (primary graph database) ----------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Name of the graph that holds users and workspaces
CONTROL_GRAPH=control
# Workspace graph created at startup, named ws_<id>
DEFAULT_WORKSPACE_ID=acme
# Vector index on Memory.embedding. Leave false until you use embeddings
ENABLE_VECTOR_INDEX=false
EMBEDDING_DIM=768

# ---------- Redis (cache, pub/sub, SSE fan-out later) ----------
# Port 6380 on the host so it does not clash with FalkorDB on 6379
REDIS_URL=redis://localhost:6380/0

# ---------- AI model: xAI Grok (OpenAI-compatible API) ----------
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
# Copy the exact model ids from console.x.ai > Models. These two are guesses
# based on the display names (Grok 4.7, Grok Build 0.1).
# GET /api/v1/health/ready?deep=true checks them against your account.
LLM_MODEL_REASONING=grok-4.7
LLM_MODEL_FAST=grok-build-0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2000
# 1 = replay cached model responses (demo safety), 0 = always call the API
DEMO_CACHE=0
