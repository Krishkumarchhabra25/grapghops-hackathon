    {
      "label": "Incident",
      "properties": {
        "id": "inc-2481",
        "title": "Checkout error spike",
        "severity": "Critical",
        "status": "Open",
        "summary": "High error rate on checkout-api causing failed payments.",
        "impact": "Customers cannot complete purchases.",
        "started_at": 1792012000000
      }
    },
    {
      "label": "Incident",
      "properties": {
        "id": "inc-2410",
        "title": "Payment SDK timeout regression",
        "severity": "High",
        "status": "Resolved",
        "summary": "checkout-api timed out when payment-sdk 3.2.0 changed its default retry policy.",
        "impact": "Checkout was down for 30 minutes.",
        "started_at": 1791500000000,
        "resolved_at": 1791502000000,
        "root_cause": "payment-sdk 3.2.0 retry policy change"
      }
    },
    {
      "label": "Incident",
      "properties": {
        "id": "inc-2495",
        "title": "Notification service OOM crash",
        "severity": "High",
        "status": "Open",
        "summary": "Notification pods are crashing due to OutOfMemoryError.",
        "impact": "Users are not receiving emails or push notifications.",
        "started_at": 1792020000000
      }
    },
    {
      "label": "Incident",
      "properties": {
        "id": "inc-2496",
        "title": "Subscription DB Deadlock",
        "severity": "Critical",
        "status": "Open",
        "summary": "Recurring billing jobs are hanging due to database lock contention.",
        "impact": "Users cannot renew subscriptions.",
        "started_at": 1792021000000
      }
    },
    {
      "label": "Incident",
      "properties": {
        "id": "inc-2497",
        "title": "Inventory sync failure",
        "severity": "Medium",
        "status": "Investigating",
        "summary": "Inventory service failing to sync with external warehouse API.",
        "impact": "Stock levels are delayed by 2 hours.",
        "started_at": 1792022000000
      }
    },
    {
      "label": "Incident",
      "properties": {
        "id": "inc-2300",
        "title": "Recommendation engine latency",
        "severity": "Medium",
        "status": "Resolved",
        "summary": "Recommendation API responding in over 3 seconds.",
        "impact": "Slower page loads for homepage.",
        "started_at": 1791000000000,
        "resolved_at": 1791002000000,
        "root_cause": "CPU throttling due to insufficient pod replicas."
      }
    },
