      }
    },
    {
      "label": "Fix",
      "properties": {
        "id": "fix-rollback-sdk-3-1-8",
        "title": "Rollback payment-sdk to 3.1.8",
        "kind": "rollback",
        "steps": ["Re-pin payment-sdk to 3.1.8", "Deploy to production", "Run contract tests"],
        "risk": "low"
      }
    },
    {
      "label": "Fix",
      "properties": {
        "id": "fix-bump-notification-ram",
        "title": "Increase Notification Pod Memory",
        "kind": "config",
        "steps": ["Update helm chart limits.memory to 4Gi", "Rolling restart deployment"],
        "risk": "low"
      }
    },
    {
      "label": "Fix",
      "properties": {
        "id": "fix-kill-db-locks",
        "title": "Kill Blocking DB Queries",
        "kind": "database",
        "steps": ["Run pg_terminate_backend on blocking PID", "Restart subscription workers"],
        "risk": "medium"
      }
    },
    {
      "label": "Fix",
      "properties": {
        "id": "fix-scale-recommendation",
        "title": "Scale Recommendation Engine",
        "kind": "scale",
        "steps": ["kubectl scale deployment/recommendation --replicas=5"],
        "risk": "low"
      }
    },
    {
      "label": "Outcome",
      "properties": {
        "id": "out-100",
